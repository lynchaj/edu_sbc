	(global_label "GPIO_PWR_SELECT" (shape power_in) (at 254.0 95.25 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "00000000-0000-0000-0000-000065040038"))
	(text "82C55 PPI PARALLEL INTERFACE (LAB 5)\n- U9: 82C55 (CMOS Programmable Peripheral Interface, 40-pin DIP Socketed)\n- Decoded Base Address: Ports $00-$03\n  - Port $00: Port A Data Register\n  - Port $01: Port B Data Register\n  - Port $02: Port C Data Register\n  - Port $03: Control Word Register\n- Pin 26: VCC (+5V), Pin 7: GND\n- C15: 100nF Ceramic Bypass Capacitor mounted directly adjacent to Pin 26\n- Pin 35: RESET (driven by active-high RESET_HIGH from 74HCT14)\n- Pin 6: /CS (driven by nPPI_CS from 74HCT138)\n- Pin 5: /RD (nRD), Pin 36: /WR (nWR), Pin 8: A1, Pin 9: A0\n- Pins 27-34: Data Bus D0-D7"
		(at 38.1 133.35 0)
		(effects (font (size 1.3 1.3) (bold yes)) (justify left top))
		(uuid "00000000-0000-0000-0000-000065040090")
	)
	(text "26-PIN (13x2) HORIZONTAL SHROUDED GPIO BOX HEADER (LAB 5)\n- J2: 26-pin (13x2) 2.54mm pitch Horizontal Shrouded Box Header (Right Edge of PCB)\n- Pinout Mapping (Odd / Even Interleaved):\n  - Odd Pins 1, 3, 5, 7, 9, 11, 13, 15: Port A (PA0..PA7)\n  - Even Pins 2, 4, 6, 8, 10, 12, 14, 16: Port B (PB0..PB7)\n  - Pins 17..24: Port C (PC0..PC7: 17=PC0, 18=PC1, 19=PC2, 20=PC3, 21=PC4, 22=PC5, 23=PC6, 24=PC7)\n  - Pin 25: Dedicated System Ground (GND)\n  - Pin 26: Selectable Power/Ground Line (GPIO_PWR_SELECT)\n\nPOWER SELECTOR JUMPER:\n- JP3 (JP_GPIO_PWR - 3-pin 2.54mm pitch):\n  - Pins 1-2 (Default): Connects Pin 26 to +5V (VCC)\n  - Pins 2-3: Connects Pin 26 to Ground (GND)"
		(at 190.5 133.35 0)
		(effects (font (size 1.3 1.3) (bold yes)) (justify left top))
		(uuid "00000000-0000-0000-0000-000065040091")
	)
)
