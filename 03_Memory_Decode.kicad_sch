	(global_label "ROM_WE_PULSE" (shape input) (at 190.5 88.9 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "00000000-0000-0000-0000-000065030023"))
	(text "MEMORY DECODING (74HCT139, LAB 4)\n- U5: 74HCT139 Dual 2-to-4 Line Decoder (DIP-16 Socketed)\n- 1/E Enable = nMREQ\n- 1A = A15, 1B = GND\n- 1Y0 Output = nROM_CS ($0000 - $7FFF, 32KB Lower Half)\n- 1Y1 Output = nRAM_CS ($8000 - $FFFF, 32KB Upper Half)\n- C11: 100nF Ceramic Bypass Capacitor mounted at Pin 16\n\nI/O PORT DECODING (74HCT138, LAB 4)\n- U6: 74HCT138 3-to-8 Line Decoder (DIP-16 Socketed)\n- /G2A = nIORQ, G1 = nM1 (Active High during regular I/O, Low during INT-ACK)\n- /G2B = GND\n- Inputs A, B, C = A3, A4, A5\n- Y0 Output = nPPI_CS (Base Port $00-$03 for 82C55 PPI)\n- Y1 Output = nUART_CS (Base Port $08-$0F for 16C550 UART)\n- Y2..Y7 = Spare decoded I/O chip selects\n- C12: 100nF Ceramic Bypass Capacitor mounted at Pin 16"
		(at 38.1 133.35 0)
		(effects (font (size 1.3 1.3) (bold yes)) (justify left top))
		(uuid "00000000-0000-0000-0000-000065030090")
	)
	(text "UNIVERSAL 28-PIN ROM SOCKET & PROTECTION JUMPERS (LAB 4)\n- U7: 28-pin DIP Socket for 28C256 (32KB Parallel EEPROM) or 27C256 (32KB UV-EPROM)\n- C13: 100nF Ceramic Bypass Capacitor mounted at Pin 28 (VCC)\n- Pin 20: nOE = nRD, Pin 22: nCE = nROM_CS\n- JP1 (JP_ROM_TYPE - 3-pin 2.54mm pitch):\n  - Pins 1-2 (EEPROM 28C256): Pin 1 connects to A14; Pin 27 routes to JP2\n  - Pins 2-3 (EPROM 27C256): Pin 1 connects to +5V (VPP); Pin 27 routes to A14\n- JP2 (JP_ROM_WP - 3-pin 2.54mm pitch):\n  - Pins 1-2: Write-Protect (Ties Pin 27 to +5V hardware lock)\n  - Pins 2-3: Write-Enable (Connects Pin 27 to nWR strobe for in-circuit flashing)\n\n32KB STATIC RAM SUBSYSTEM (LAB 4)\n- U8: AS6C62256 / 62256 32KB Static RAM (DIP-28 Socketed)\n- C14: 100nF Ceramic Bypass Capacitor mounted at Pin 28 (VCC)\n- Pin 20: nCE = nRAM_CS, Pin 22: nOE = nRD, Pin 27: nWE = nWR\n- Address Lines A0..A14, Data Lines D0..D7"
		(at 190.5 133.35 0)
		(effects (font (size 1.3 1.3) (bold yes)) (justify left top))
		(uuid "00000000-0000-0000-0000-000065030091")
	)
)
